></mxCell><mxCell id="c96" value="Label: event [guard] / action; an arrow without an event fires when the do / activity ends." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="54" y="1269" width="1072" height="18" as="geometry" /></mxCell><mxCell id="c97" value="Guards of the transitions from one state exclude each other, so there are no conflicts." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="54" y="1288" width="1072" height="18" as="geometry" /></mxCell><mxCell id="c98" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1180" y="1190" width="1100" height="130" as="geometry" /></mxCell><mxCell id="c99" value="States and the use case UC-1 (Part 5)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=14;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1194" y="1202" width="1072" height="20" as="geometry" /></mxCell><mxCell id="c100" value="Thinking = steps 3–5;  Showing the answer = steps 6–7;  Showing hints = EXT-2 (graded lab)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1194" y="1231" width="1072" height="18" as="geometry" /></mxCell><mxCell id="c101" value="EXT-3 “Daily AI limit reached” and EXT-1 “Not found in the course materials” lead to Showing the message." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1194" y="1250" width="1072" height="18" as="geometry" /></mxCell><mxCell id="c102" value="usage : DailyUsage changes only after a successful answer, not after a refusal or an error." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1194" y="1269" width="1072" height="18" as="geometry" /></mxCell><mxCell id="c103" value="At 00:00 the object returns to “Available”, so the student has the full limit again every day." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1194" y="1288" width="1072" height="18" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>