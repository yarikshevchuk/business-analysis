e="" style="html=1;edgeStyle=none;rounded=0;strokeColor=#000000;strokeWidth=1;endArrow=open;endFill=1;startArrow=none;startFill=1;exitX=0.5000;exitY=1.0000;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryPerimeter=0;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d5" value="requests left today?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="410" y="1580" width="180" height="70" as="geometry" /></mxCell><mxCell id="e44" value="" style="html=1;edgeStyle=none;rounded=0;strokeColor=#000000;strokeWidth=1;endArrow=open;endFill=1;startArrow=none;startFill=1;exitX=0.5000;exitY=1.0000;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryPerimeter=0;" edge="1" parent="1" source="c3" target="d5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c4a" value="Show the answer with slide links, marked “AI-generated”, and how many requests are left today" style="rounded=1;absoluteArcSize=1;arcSize=18;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="200" y="1698" width="260" height="84" as="geometry" /></mxCell><mxCell id="c4b" value="Show the answer with slide links, marked “AI-generated”, and “Daily limit reached, new questions tomorrow”" style="rounded=1;absoluteArcSize=1;arcSize=18;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="570" y="1698" width="260" height="84" as="geometry" /></mxCell><mxCell id="e45" value="" style="html=1;edgeStyle=none;rounded=0;strokeColor=#000000;strokeWidth=1;endArrow=open;endFill=1;startArrow=none;startFill=1;exitX=0.0000;exitY=0.5000;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryPerimeter=0;" edge="1" parent="1" source="d5" target="c4a"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="330" y="1615" /></Array></mxGeometry></mxCell><mxCell id="c46" value="[yes]" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=11;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="361.7" y="1593.5" width="36.6" height="15" as="geometry" /></mxCell><mxCell id="e47" value="" style="html=1;edgeStyle=none;rounded=0;strokeColor=#000000;strokeWidth=1;endArrow=open;endFill=1;startArrow=none;startFill=1;exitX=1.0000;exitY=0.5000;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryPerimeter=0;" edge="1" parent="1" source="d5" target="c4b"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="1615" /></Array></mxGeometry></mxCell><mxCell id="c48" value="[no]" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=11;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="604.56" y="1593.5" width="30.88" height="15" as="geometry" /></mxCell><mxCell id="mg" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="485" y="1845" width="30" height="30" as="geometry" /></mxCell><mxCell id="e49" value="" style="html=1;edgeStyle=none;rounded=0;strokeColor=#000000;strokeWidth=1;endArrow=open;endFill=1;startArrow=none;startFill=1;exitX=0.5000;exitY=1.0000;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryPerimeter=0;" edge="1" parent="1" source="c4a" target="mg"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="330" y="1860" /></Array></mxGeometry></mxCell><mxCell id="e50" value="" style="html=1;edgeStyle=none;rounded=0;strokeColor=#000000;strokeWidth=1;endArrow=open;endFill=1;startArrow=none;startFill=1;exitX=0.5000;exitY=1.0000;exitPerimeter=0;entryX=1.0000;entryY=0.5000;entryPerimeter=0;" edge="1" parent="1" source="c4b" target="mg"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="1860" /></Array></mxGeometry></mxCell><mxCell id="c5" value="Read the answer, open the slides it refers to" style="rounded=1;absoluteArcSize=1;arcSize=18;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="375" y="1928" width="250" height="64" as="geometry" /></mxCell><mxCell id="e51" value="" style="html=1;edgeStyle=none;rounded=0;strokeColor=#000000;strokeWidth=1;endArrow=open;endFill=1;startArrow=none;startFill=1;exitX=0.5000;exitY=1.0000;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryPerimeter=0;" edge="1" parent="1" source="mg" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fin" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="489" y="2049" width="22" height="22" as="geometry" /></mxCell><mxCell id="c52" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="493" y="2053" width="14" height="14" as="geometry" /></mxCell><mxCell id="e53" value="" style="html=1;edgeStyle=none;rounded=0;strokeColor=#000000;strokeWidth=1;endArrow=open;endFill=1;startArrow=none;startFill=1;exitX=0.5000;exitY=1.0000;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryPerimeter=0;" edge="1" parent="1" source="c5" target="fin"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c54" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="2120" width="1120" height="130" as="geometry" /></mxCell><mxCell id="c55" value="Reading the diagram" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=14;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="54" y="2132" width="1092" height="20" as="geometry" /></mxCell><mxCell id="c56" value="The whole diagram is one flow of the AI assistant; the student sends the question and reads the answer, the assistant does the rest." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="54" y="2161" width="1092" height="18" as="geometry" /></mxCell><mxCell id="c57" value="Rounded boxes – actions;  diamonds – decisions;  thick bars – fork and join;  the small empty diamond – merge of two branches." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="54" y="2180" width="1092" height="18" as="geometry" /></mxCell><mxCell id="c58" value="Bullseye – the end of the whole activity: every branch stops, also the parallel one." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="54" y="2199" width="1092" height="18" as="geometry" /></mxCell><mxCell id="c59" value="One fork: the graded-task check and the search in the slides are independent. The decision “slides found?” belongs to the search branch." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="54" y="2218" width="1092" height="18" as="geometry" /></mxCell><mxCell id="c60" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="2260" width="1120" height="149" as="geometry" /></mxCell><mxCell id="c61" value="Decisions of the use case UC-1 (Part 5)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=14;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="54" y="2272" width="1092" height="20" as="geometry" /></mxCell><mxCell id="c62" value="“requests left?” – [no] is EXT-3 “Daily AI limit reached”: the student has nothing left, so the flow ends here." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="54" y="2301" width="1092" height="18" as="geometry" /></mxCell><mxCell id="c63" value="“slides found?” – [no] is EXT-1 “Not found in the course materials”: without slides there is no answer, so the whole activity ends, also the other branch." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="54" y="2320" width="1092" height="18" as="geometry" /></mxCell><mxCell id="c64" value="Graded lab (EXT-2) does not stop the flow: its result only switches the LLM to “hints only”." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="54" y="2339" width="1092" height="18" as="geometry" /></mxCell><mxCell id="c65" value="“reply in 30 s?” – [no] shows the message (assumption); “try again” returns to typing the question, otherwise the flow ends." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="54" y="2358" width="1092" height="18" as="geometry" /></mxCell><mxCell id="c66" value="“requests left today?” – after the request is counted the student sees either how many requests are left or that the limit is reached." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="54" y="2377" width="1092" height="18" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>