/mxCell><mxCell id="c4" value="Show the answer with slide links, marked “AI-generated”" style="rounded=1;absoluteArcSize=1;arcSize=18;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="375" y="1598" width="250" height="64" as="geometry" /></mxCell><mxCell id="e43" value="" style="html=1;edgeStyle=none;rounded=0;strokeColor=#000000;strokeWidth=1;endArrow=open;endFill=1;startArrow=none;startFill=1;exitX=0.5000;exitY=1.0000;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryPerimeter=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c5" value="Read the answer, open the slides it refers to" style="rounded=1;absoluteArcSize=1;arcSize=18;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="375" y="1698" width="250" height="64" as="geometry" /></mxCell><mxCell id="e44" value="" style="html=1;edgeStyle=none;rounded=0;strokeColor=#000000;strokeWidth=1;endArrow=open;endFill=1;startArrow=none;startFill=1;exitX=0.5000;exitY=1.0000;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryPerimeter=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fin" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="489" y="1819" width="22" height="22" as="geometry" /></mxCell><mxCell id="c45" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="493" y="1823" width="14" height="14" as="geometry" /></mxCell><mxCell id="e46" value="" style="html=1;edgeStyle=none;rounded=0;strokeColor=#000000;strokeWidth=1;endArrow=open;endFill=1;startArrow=none;startFill=1;exitX=0.5000;exitY=1.0000;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryPerimeter=0;" edge="1" parent="1" source="c5" target="fin"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c47" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1890" width="1120" height="130" as="geometry" /></mxCell><mxCell id="c48" value="Reading the diagram" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=14;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="54" y="1902" width="1092" height="20" as="geometry" /></mxCell><mxCell id="c49" value="The whole diagram is one flow of the AI assistant; the student sends the question and reads the answer, the assistant does the rest." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="54" y="1931" width="1092" height="18" as="geometry" /></mxCell><mxCell id="c50" value="Rounded boxes – actions;  diamonds – decisions;  thick bars – fork and join;  rectangles – objects passed on by an action." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="54" y="1950" width="1092" height="18" as="geometry" /></mxCell><mxCell id="c51" value="Bullseye – the end of the flow;  circle with a cross – flow final: only that branch ends." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="54" y="1969" width="1092" height="18" as="geometry" /></mxCell><mxCell id="c52" value="One fork: the graded-task check and the search in the slides are independent. The decision “slides found?” belongs to the search branch." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="54" y="1988" width="1092" height="18" as="geometry" /></mxCell><mxCell id="c53" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="2030" width="1120" height="130" as="geometry" /></mxCell><mxCell id="c54" value="Decisions of the use case UC-1 (Part 5)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=14;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="54" y="2042" width="1092" height="20" as="geometry" /></mxCell><mxCell id="c55" value="“requests left?” – [no] is EXT-3 “Daily AI limit reached”: the student has nothing left, so the flow ends here." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="54" y="2071" width="1092" height="18" as="geometry" /></mxCell><mxCell id="c56" value="“slides found?” – [no] is EXT-1 “Not found in the course materials”: nothing is sent to the LLM." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="54" y="2090" width="1092" height="18" as="geometry" /></mxCell><mxCell id="c57" value="Graded lab (EXT-2) does not stop the flow: its result only switches the LLM to “hints only”." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="54" y="2109" width="1092" height="18" as="geometry" /></mxCell><mxCell id="c58" value="“reply in 30 s?” – [no] ends the flow (assumption);  the request is counted only after an answer is created." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="54" y="2128" width="1092" height="18" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>