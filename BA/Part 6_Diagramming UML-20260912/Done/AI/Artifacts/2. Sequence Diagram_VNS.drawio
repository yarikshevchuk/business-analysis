=block;endFill=1;startArrow=none;startFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="536" y="952" as="sourcePoint" /><mxPoint x="1950" y="952" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c84" value="2.6 : «create» answer(text, slides)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1129.8" y="933" width="226.4" height="16" as="geometry" /></mxCell><mxCell id="e85" value="" style="html=1;edgeStyle=none;rounded=0;strokeColor=#000000;strokeWidth=1;endArrow=block;endFill=1;startArrow=none;startFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2016" y="998" as="sourcePoint" /><mxPoint x="2110" y="998" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c86" value="2.6.1 : «create» links" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1990.36" y="979" width="145.28" height="16" as="geometry" /></mxCell><mxCell id="e87" value="" style="html=1;edgeStyle=none;rounded=0;strokeColor=#000000;strokeWidth=1;endArrow=block;endFill=1;startArrow=none;startFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="536" y="1045" as="sourcePoint" /><mxPoint x="764" y="1045" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c88" value="2.7 : count()" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="605.44" y="1026" width="89.12" height="16" as="geometry" /></mxCell><mxCell id="e89" value="" style="html=1;edgeStyle=none;rounded=0;strokeColor=#000000;strokeWidth=1;endArrow=block;endFill=1;startArrow=none;startFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="524" y="1090" as="sourcePoint" /><mxPoint x="296" y="1090" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c90" value="3 : showAnswer(answer)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="337.36" y="1071" width="145.28" height="16" as="geometry" /></mxCell><mxCell id="e91" value="" style="html=1;edgeStyle=none;rounded=0;strokeColor=#000000;strokeWidth=1;endArrow=block;endFill=1;startArrow=none;startFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="284" y="1130" as="sourcePoint" /><mxPoint x="86" y="1130" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c92" value="3.1 : display(answer, “AI-generated”)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="65.56" y="1111" width="238.88" height="16" as="geometry" /></mxCell><mxCell id="c93" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1250" width="1080" height="130" as="geometry" /></mxCell><mxCell id="c94" value="Reading the diagram" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=14;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="54" y="1262" width="1052" height="20" as="geometry" /></mxCell><mxCell id="c95" value="Agent (Student) on the left; every other object has a dashed lifeline and a focus of control (narrow white bar)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="54" y="1291" width="1052" height="18" as="geometry" /></mxCell><mxCell id="c96" value="Thick border – active objects. :Answer and :SlideLink appear on the time line at the moment of creation (2.6, 2.6.1)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="54" y="1310" width="1052" height="18" as="geometry" /></mxCell><mxCell id="c97" value="Solid line, filled arrow – call;  dashed line, open arrow – return;  loop on a lifeline – message to self." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="54" y="1329" width="1052" height="18" as="geometry" /></mxCell><mxCell id="c98" value="[condition] – guard: 2.1a, 2.4a, 2.5a leave the main flow, EXT-2 (2.3) only changes how the flow goes on." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="54" y="1348" width="1052" height="18" as="geometry" /></mxCell><mxCell id="c99" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1160" y="1250" width="1060" height="130" as="geometry" /></mxCell><mxCell id="c100" value="Order of the main flow (use case UC-1)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=14;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1174" y="1262" width="1032" height="20" as="geometry" /></mxCell><mxCell id="c101" value="Cheap checks come first: limit (2.1), graded task (2.2–2.3), search in the materials (2.4). The LLM is called only after them (2.5)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1174" y="1291" width="1032" height="18" as="geometry" /></mxCell><mxCell id="c102" value="2.4a: nothing found – no request to the LLM is sent and the request is not counted." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1174" y="1310" width="1032" height="18" as="geometry" /></mxCell><mxCell id="c103" value="2.5a: the LLM does not answer in 30 s – the student gets a message and the request is not counted (assumption)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1174" y="1329" width="1032" height="18" as="geometry" /></mxCell><mxCell id="c104" value="2.7: the request is counted only after the answer exists; then the answer is shown (3) and marked “AI-generated” (3.1)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1174" y="1348" width="1032" height="18" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>