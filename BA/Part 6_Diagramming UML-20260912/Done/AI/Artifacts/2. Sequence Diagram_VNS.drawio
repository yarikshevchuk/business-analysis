olor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="54" y="1600.0" width="1052" height="18" as="geometry" /></mxCell><mxCell id="s109" value="Solid line, filled arrow – call;  dashed line, open arrow – reply (every call gets one);  loop on a lifeline – message to self." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="54" y="1619.0" width="1052" height="18" as="geometry" /></mxCell><mxCell id="s110" value="alt – one operand per extension of UC-1 ([left = 0] EXT-3, [graded] EXT-2, [no slides] EXT-1, [no reply in 30 s]); [else] – main flow." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="54" y="1638.0" width="1052" height="18" as="geometry" /></mxCell><mxCell id="s111" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1160" y="1540.0" width="1060" height="130" as="geometry" /></mxCell><mxCell id="s112" value="Order of the main flow (use case UC-1)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=14;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1174" y="1552.0" width="1032" height="20" as="geometry" /></mxCell><mxCell id="s113" value="Cheap checks come first: limit (2.1), graded task (2.2–2.3), search in the materials (2.4). The LLM is called only after them (2.5)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1174" y="1581.0" width="1032" height="18" as="geometry" /></mxCell><mxCell id="s114" value="2.4a: nothing found – no request to the LLM is sent and the request is not counted." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1174" y="1600.0" width="1032" height="18" as="geometry" /></mxCell><mxCell id="s115" value="2.5a: the LLM does not answer in 30 s – the student gets a message and the request is not counted (assumption)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1174" y="1619.0" width="1032" height="18" as="geometry" /></mxCell><mxCell id="s116" value="2.7: the request is counted only after the answer exists; then the answer is shown (3) and marked “AI-generated” (3.1)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1174" y="1638.0" width="1032" height="18" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
