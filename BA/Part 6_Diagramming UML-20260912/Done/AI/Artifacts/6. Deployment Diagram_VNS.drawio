eter=0;" edge="1" parent="1" source="app" target="llm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="HTTPS, REST" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2168.68" y="314" width="82.64" height="16" as="geometry" /></mxCell><mxCell id="c16" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1260" width="1260" height="130" as="geometry" /></mxCell><mxCell id="c17" value="Reading the diagram" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=14;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="54" y="1272" width="1232" height="20" as="geometry" /></mxCell><mxCell id="c18" value="Cubes – nodes; «processor» nodes can run program components. Client devices are processors too: they run the browser." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="54" y="1301" width="1232" height="18" as="geometry" /></mxCell><mxCell id="c19" value="Components are placed in the node that runs them; «table» and «document» are data stored on a node." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="54" y="1320" width="1232" height="18" as="geometry" /></mxCell><mxCell id="c20" value="A line without arrows – a physical connection, with the protocol written over it. The Internet is a cloud." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="54" y="1339" width="1232" height="18" as="geometry" /></mxCell><mxCell id="c21" value="The LLM API belongs to an external provider: only the connection to it is ours." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="54" y="1358" width="1232" height="18" as="geometry" /></mxCell><mxCell id="c22" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1340" y="1260" width="1260" height="130" as="geometry" /></mxCell><mxCell id="c23" value="Deployment decisions (assumptions to confirm)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=14;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1354" y="1272" width="1232" height="20" as="geometry" /></mxCell><mxCell id="c24" value="Stack from Ідея_проекту.md, 7.1: React / Next.js, Node.js (NestJS), PostgreSQL with pgvector, external LLM API." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1354" y="1301" width="1232" height="18" as="geometry" /></mxCell><mxCell id="c25" value="All AI services run on one application server in the pilot; the LlmGateway is the only component that reaches the LLM." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1354" y="1320" width="1232" height="18" as="geometry" /></mxCell><mxCell id="c26" value="One database holds lectures, slides, labs, AI results (answers, summaries, tests, flashcards), test attempts, daily request counters and settings (the 8 tables of the component diagram)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1354" y="1339" width="1232" height="18" as="geometry" /></mxCell><mxCell id="c27" value="The browser never calls the LLM API: its key stays on the application server." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1354" y="1358" width="1232" height="18" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>