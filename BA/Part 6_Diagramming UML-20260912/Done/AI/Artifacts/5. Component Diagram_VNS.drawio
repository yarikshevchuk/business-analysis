ll=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1805" y="940" as="sourcePoint" /><mxPoint x="1805" y="1040" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c40" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1190" width="1300" height="130" as="geometry" /></mxCell><mxCell id="c41" value="Reading the diagram" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=14;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="54" y="1202" width="1272" height="20" as="geometry" /></mxCell><mxCell id="c42" value="Boxes with two small rectangles – components; stereotype: «executable» (starts as a program), «library», «table»." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="54" y="1231" width="1272" height="18" as="geometry" /></mxCell><mxCell id="c43" value="Circle with a name – interface (I…). Solid line from a component to a circle – the component provides the interface." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="54" y="1250" width="1272" height="18" as="geometry" /></mxCell><mxCell id="c44" value="Dashed arrow to a circle – the component uses the interface. A line that joins several arrows (a “bus”) means that several components use the interface." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="54" y="1269" width="1272" height="18" as="geometry" /></mxCell><mxCell id="c45" value="Folders group the components by layer. “classes:” lists the classes of the component (the classes of the class diagram, Part 5 AI)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="54" y="1288" width="1272" height="18" as="geometry" /></mxCell><mxCell id="c46" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1380" y="1190" width="1280" height="149" as="geometry" /></mxCell><mxCell id="c47" value="The AI tools and where they are in the software" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=14;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1394" y="1202" width="1252" height="20" as="geometry" /></mxCell><mxCell id="c48" value="Three AI tools = three components of the first row: questions (UC-1), summaries (UC-4), self-check tests and flashcards (UC-5, UC-6)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1394" y="1231" width="1252" height="18" as="geometry" /></mxCell><mxCell id="c49" value="The second row is shared by the tools: the search in the course slides (SlideSearch) and the only door to the LLM (LlmGateway). The daily limit (DailyUsage) is an entity of DomainModel." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1394" y="1250" width="1252" height="18" as="geometry" /></mxCell><mxCell id="c50" value="Only LlmGateway talks to the external LLM API, so the prompt rules (“only the course materials”, “AI-generated”) are kept in one place." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1394" y="1269" width="1252" height="18" as="geometry" /></mxCell><mxCell id="c51" value="Summaries are saved (table ai_result) and reused (Assumption 2 in Part 5): SummaryService reads the saved one before calling the LLM." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1394" y="1288" width="1252" height="18" as="geometry" /></mxCell><mxCell id="c52" value="Stack: React / Next.js, Node.js (NestJS), PostgreSQL with pgvector for the search, external LLM API (Ідея_проекту.md, 7.1)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#000000;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1394" y="1307" width="1252" height="18" as="geometry" /></mxCell><mxCell id="dm1" value="" style="html=1;edgeStyle=none;rounded=0;strokeColor=#000000;strokeWidth=1;startArrow=none;startFill=1;endArrow=none;endFill=1;jumpStyle=arc;jumpSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="490" as="sourcePoint" /><mxPoint x="560" y="770" as="targetPoint" /></mxGeometry></mxCell><mxCell id="dm2" value="" style="html=1;edgeStyle=none;rounded=0;strokeColor=#000000;strokeWidth=1;startArrow=none;startFill=1;endArrow=none;endFill=1;jumpStyle=arc;jumpSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="930" y="490" as="sourcePoint" /><mxPoint x="930" y="770" as="targetPoint" /></mxGeometry></mxCell><mxCell id="dm3" value="" style="html=1;edgeStyle=none;rounded=0;strokeColor=#000000;strokeWidth=1;startArrow=none;startFill=1;endArrow=none;endFill=1;jumpStyle=arc;jumpSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1330" y="490" as="sourcePoint" /><mxPoint x="1330" y="770" as="targetPoint" /></mxGeometry></mxCell><mxCell id="dm4" value="" style="html=1;edgeStyle=none;rounded=0;strokeColor=#000000;strokeWidth=1;startArrow=none;startFill=1;endArrow=none;endFill=1;jumpStyle=arc;jumpSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1150" y="740" as="sourcePoint" /><mxPoint x="1150" y="770" as="targetPoint" /></mxGeometry></mxCell><mxCell id="dm5" value="" style="html=1;edgeStyle=none;rounded=0;strokeColor=#000000;strokeWidth=1;startArrow=none;startFill=1;endArrow=none;endFill=1;jumpStyle=arc;jumpSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="770" as="sourcePoint" /><mxPoint x="1330" y="770" as="targetPoint" /></mxGeometry></mxCell><mxCell id="dm6" value="" style="html=1;edgeStyle=none;rounded=0;strokeColor=#000000;strokeWidth=1;startArrow=none;startFill=1;dashed=1;endArrow=open;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1240" y="770" as="sourcePoint" /><mxPoint x="1240" y="880" as="targetPoint" /></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>