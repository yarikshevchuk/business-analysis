<mxfile host="drawio" version="32.6.10"><diagram name="Deployment Diagram" id="d1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t11" value="&lt;b&gt;Deployment diagram: AI assistant on the lecture page (UC-04)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1800" height="30" as="geometry"/></mxCell><mxCell id="t12" value="VNS — Custom University Learning Platform · Team «20/80» · Part 6, Lab 8 (Manual) · nodes, physical connections and the components placed on them" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1800" height="20" as="geometry"/></mxCell><mxCell id="t13" value="Used by: Student, Lecturer, Administrator" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;whiteSpace=wrap;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="215" width="300" height="28" as="geometry"/></mxCell><mxCell id="b14" value="«device»&lt;br&gt;&lt;b&gt;Client device&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;{web browser on a PC or a phone}&lt;/font&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=18;fillColor=#f5f5f5;strokeColor=#000000;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="300" height="260" as="geometry"/></mxCell><mxCell id="b15" value="«executable»&lt;br&gt;&lt;b&gt;LectureUi&lt;/b&gt;" style="shape=component;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#000000;fontSize=11;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="70" y="380" width="220" height="80" as="geometry"/></mxCell><mxCell id="b16" value="Internet" style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="300" width="170" height="110" as="geometry"/></mxCell><mxCell id="b17" value="«processor»&lt;br&gt;&lt;b&gt;Application server&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;{OS = Linux, runtime = Node.js or Python}&lt;/font&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=18;fillColor=#f5f5f5;strokeColor=#000000;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="90" width="560" height="350" as="geometry"/></mxCell><mxCell id="b18" value="«executable»&lt;br&gt;&lt;b&gt;AiService&lt;/b&gt;" style="shape=component;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#000000;fontSize=11;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="710" y="170" width="240" height="80" as="geometry"/></mxCell><mxCell id="b19" value="«library»&lt;br&gt;&lt;b&gt;MaterialSearch&lt;/b&gt;" style="shape=component;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#000000;fontSize=11;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="980" y="170" width="230" height="80" as="geometry"/></mxCell><mxCell id="b20" value="«library»&lt;br&gt;&lt;b&gt;DomainModel&lt;/b&gt;" style="shape=component;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#000000;fontSize=11;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="710" y="290" width="240" height="80" as="geometry"/></mxCell><mxCell id="b21" value="«library»&lt;br&gt;&lt;b&gt;LlmClient&lt;/b&gt;" style="shape=component;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#000000;fontSize=11;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="980" y="290" width="230" height="80" as="geometry"/></mxCell><mxCell id="b22" value="«processor»&lt;br&gt;&lt;b&gt;Database server&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;{PostgreSQL with pgvector}&lt;/font&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=18;fillColor=#f5f5f5;strokeColor=#000000;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="580" width="560" height="270" as="geometry"/></mxCell><mxCell id="b23" value="«table»&lt;br&gt;&lt;b&gt;slide&lt;/b&gt;" style="shape=component;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#000000;fontSize=11;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="710" y="660" width="230" height="66" as="geometry"/></mxCell><mxCell id="b24" value="«table»&lt;br&gt;&lt;b&gt;ai_settings&lt;/b&gt;" style="shape=component;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#000000;fontSize=11;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="960" y="660" width="230" height="66" as="geometry"/></mxCell><mxCell id="b25" value="«table»&lt;br&gt;&lt;b&gt;ai_usage_record&lt;/b&gt;" style="shape=component;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#000000;fontSize=11;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="710" y="746" width="230" height="66" as="geometry"/></mxCell><mxCell id="b26" value="«table»&lt;br&gt;&lt;b&gt;ai_answer&lt;/b&gt;" style="shape=component;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#000000;fontSize=11;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="960" y="746" width="230" height="66" as="geometry"/></mxCell><mxCell id="b27" value="Internet" style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1290" y="280" width="150" height="100" as="geometry"/></mxCell><mxCell id="b28" value="«processor»&lt;br&gt;&lt;b&gt;LLM API provider&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;{external service, public cloud}&lt;/font&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=18;fillColor=#f5f5f5;strokeColor=#000000;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1500" y="240" width="300" height="260" as="geometry"/></mxCell><mxCell id="b29" value="«external system»&lt;br&gt;&lt;b&gt;LLM API&lt;/b&gt;" style="shape=component;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#000000;fontSize=11;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1530" y="370" width="230" height="80" as="geometry"/></mxCell><mxCell id="e30" value="" style="html=1;rounded=0;strokeColor=#000000;endArrow=none;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340" y="380" as="sourcePoint"/><mxPoint x="420" y="355" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t31" value="«HTTPS»" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="330" y="320" width="100" height="16" as="geometry"/></mxCell><mxCell id="e32" value="" style="html=1;rounded=0;strokeColor=#000000;endArrow=none;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="590" y="355" as="sourcePoint"/><mxPoint x="680" y="255" as="targetPoint"/><Array as="points"><mxPoint x="640" y="355"/><mxPoint x="640" y="255"/></Array></mxGeometry></mxCell><mxCell id="t33" value="«HTTPS»" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="590" y="300" width="90" height="16" as="geometry"/></mxCell><mxCell id="e34" value="" style="html=1;rounded=0;strokeColor=#000000;endArrow=none;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="960" y="440" as="sourcePoint"/><mxPoint x="960" y="580" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t35" value="«SQL over TCP/IP»" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="972" y="500" width="170" height="16" as="geometry"/></mxCell><mxCell id="e36" value="" style="html=1;rounded=0;strokeColor=#000000;endArrow=none;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1240" y="255" as="sourcePoint"/><mxPoint x="1290" y="330" as="targetPoint"/><Array as="points"><mxPoint x="1265" y="255"/><mxPoint x="1265" y="330"/></Array></mxGeometry></mxCell><mxCell id="t37" value="«HTTPS»" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1240" y="225" width="100" height="16" as="geometry"/></mxCell><mxCell id="e38" value="" style="html=1;rounded=0;strokeColor=#000000;endArrow=none;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1440" y="330" as="sourcePoint"/><mxPoint x="1500" y="330" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t39" value="«HTTPS»" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1428" y="300" width="100" height="16" as="geometry"/></mxCell><mxCell id="b40" value="&lt;b&gt;How to read&lt;/b&gt;&lt;br&gt;Cube: node (a physical element that has computing resources). Stereotype in « »: kind of node (device, processor); {…}: additional information. The components inside a node are placed (executed or stored) on it. Cloud: the Internet; the cloud is not defined in UML, but it is generally accepted in web models. Solid line: physical connection; the stereotype is the protocol.&lt;br&gt;Every executable component of the component diagram is placed on a node: LectureUi on the client device, AiService and its libraries on the application server, tables in the database, LLM API at the provider." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="860" height="150" as="geometry"/></mxCell><mxCell id="b41" value="&lt;b&gt;Assumptions&lt;/b&gt;&lt;br&gt;One application server and one database server are enough for the pilot (pages must open within 2 s, uptime at least 99.5 %, see the classification of requirements). They can be scaled later without changing this diagram.&lt;br&gt;The API key of the LLM provider is stored only in the environment variables of the application server; personal data of students are removed before the request leaves the server (BR-03).&lt;br&gt;Caching, queues and file storage of the platform are not shown, because UC-04 does not use them." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="930" y="900" width="870" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>