ent="1"><mxGeometry x="1300" y="626" width="330" height="36" as="geometry"/></mxCell><mxCell id="b64" value="" style="rounded=0;html=1;fillColor=none;dashed=1;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="880" width="1500" height="330" as="geometry"/></mxCell><mxCell id="t65" value="&lt;b&gt;:AiUsageRecord — requests of one user with one AI feature during one day (daily limit, Assumption 7)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="886" width="900" height="20" as="geometry"/></mxCell><mxCell id="b66" value="" style="ellipse;shape=startState;fillColor=#000000;strokeColor=#000000;html=1;" vertex="1" parent="1"><mxGeometry x="60" y="1050" width="22" height="22" as="geometry"/></mxCell><mxCell id="b67" value="Counting" style="swimlane;rounded=1;fontStyle=1;align=center;verticalAlign=top;startSize=30;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#000000;swimlaneFillColor=#ffffff;collapsible=0;" vertex="1" parent="1"><mxGeometry x="180" y="1010" width="230" height="86" as="geometry"/></mxCell><mxCell id="c68" value="requests &amp;lt; dailyLimit" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="b67"><mxGeometry x="0" y="30" width="230" height="56" as="geometry"/></mxCell><mxCell id="b69" value="Limit reached" style="swimlane;rounded=1;fontStyle=1;align=center;verticalAlign=top;startSize=30;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#000000;swimlaneFillColor=#ffffff;collapsible=0;" vertex="1" parent="1"><mxGeometry x="700" y="1010" width="230" height="86" as="geometry"/></mxCell><mxCell id="c70" value="requests = dailyLimit" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="b69"><mxGeometry x="0" y="30" width="230" height="56" as="geometry"/></mxCell><mxCell id="b71" value="" style="ellipse;shape=endState;fillColor=#000000;strokeColor=#000000;html=1;" vertex="1" parent="1"><mxGeometry x="1160" y="1042" width="26" height="26" as="geometry"/></mxCell><mxCell id="e72" value="" style="html=1;rounded=0;strokeColor=#000000;endArrow=open;endSize=10;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="b66" target="b67"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t73" value="create(userId, feature) /&lt;br&gt;requests := 1" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="1085" width="160" height="50" as="geometry"/></mxCell><mxCell id="e74" value="" style="html=1;rounded=0;strokeColor=#000000;endArrow=open;endSize=10;exitX=0.2500;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.7500;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="b67" target="b67"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="237.5" y="970"/><mxPoint x="352.5" y="970"/></Array></mxGeometry></mxCell><mxCell id="t75" value="request counted [requests + 1 &amp;lt; dailyLimit] /&lt;br&gt;requests := requests + 1" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="130" y="922" width="430" height="44" as="geometry"/></mxCell><mxCell id="e76" value="" style="html=1;rounded=0;strokeColor=#000000;endArrow=open;endSize=10;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="b67" target="b69"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t77" value="request counted&lt;br&gt;[requests + 1 = dailyLimit] /&lt;br&gt;requests := requests + 1" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="414" y="1002" width="282" height="48" as="geometry"/></mxCell><mxCell id="e78" value="" style="html=1;rounded=0;strokeColor=#000000;endArrow=open;endSize=10;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="b69" target="b71"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t79" value="at(00:00)" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="940" y="1030" width="210" height="20" as="geometry"/></mxCell><mxCell id="e80" value="" style="html=1;rounded=0;strokeColor=#000000;endArrow=open;endSize=10;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="b67" target="b71"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="295" y="1150"/><mxPoint x="1173" y="1150"/></Array></mxGeometry></mxCell><mxCell id="t81" value="at(00:00)" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="520" y="1126" width="300" height="20" as="geometry"/></mxCell><mxCell id="b82" value="&lt;b&gt;How to read&lt;/b&gt;&lt;br&gt;Rounded rectangle: state. Black dot: initial state, dot in a ring: final state. Arrow: transition, label: event [guard] / action.&lt;br&gt;entry / … runs when the state is entered, do / … while the object stays in it. Transitions without an event fire when the do-activity ends.&lt;br&gt;Substates of «Processing a question» are sequential: only one is active at a time. Leaving them to «Showing a message» also leaves the composite state." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1560" y="880" width="600" height="130" as="geometry"/></mxCell><mxCell id="b83" value="&lt;b&gt;Assumptions&lt;/b&gt;&lt;br&gt;after(30 s) is a time limit for the LLM answer; the value is not fixed in the requirements yet.&lt;br&gt;at(00:00): a new record is created for the next day, so the old one is closed.&lt;br&gt;The operations in do / entry are the operations of AiAssistant on the class diagram; Slide and AiAnswer details are in the sequence diagram." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1560" y="1030" width="600" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>