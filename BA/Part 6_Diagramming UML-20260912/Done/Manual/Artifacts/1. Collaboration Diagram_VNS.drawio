nt"/></mxGeometry></mxCell><mxCell id="t64" value="10a [no response in time] : showMessage(text)" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="520" y="500" width="320" height="16" as="geometry"/></mxCell><mxCell id="e65" value="" style="html=1;rounded=0;strokeColor=#000000;endArrow=block;endFill=1;endSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="544" as="sourcePoint"/><mxPoint x="560" y="544" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t66" value="13 : showResult(result)" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="520" y="526" width="320" height="16" as="geometry"/></mxCell><mxCell id="t67" value="5 : checkAccess(student, course, feature)&lt;br&gt;6 : isLimitReached(student)&lt;br&gt;7 : isAboutGradedTask(question, course)&lt;br&gt;9 : removePersonalData(text)" style="text;html=1;align=right;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="540" y="272" width="330" height="74" as="geometry"/></mxCell><mxCell id="e68" value="" style="html=1;rounded=0;strokeColor=#000000;endArrow=block;endFill=1;endSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="975" y="350" as="sourcePoint"/><mxPoint x="975" y="250" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t69" value="5.1 : ok := isEnrolled(student)" style="text;html=1;align=right;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="740" y="225" width="230" height="16" as="geometry"/></mxCell><mxCell id="e70" value="" style="html=1;rounded=0;strokeColor=#000000;endArrow=block;endFill=1;endSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1160" y="272" as="sourcePoint"/><mxPoint x="1380" y="272" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t71" value="5.2 : ok := isOn(feature)" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1150" y="252" width="240" height="16" as="geometry"/></mxCell><mxCell id="e72" value="" style="html=1;rounded=0;strokeColor=#000000;endArrow=block;endFill=1;endSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1130" y="385" as="sourcePoint"/><mxPoint x="1350" y="385" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t73" value="6.1 : n := countToday(userId)" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1120" y="366" width="260" height="16" as="geometry"/></mxCell><mxCell id="e74" value="" style="html=1;rounded=0;strokeColor=#000000;endArrow=block;endFill=1;endSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1130" y="428" as="sourcePoint"/><mxPoint x="1350" y="428" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t75" value="14 : «create» record" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1120" y="431" width="260" height="16" as="geometry"/></mxCell><mxCell id="e76" value="" style="html=1;rounded=0;strokeColor=#000000;endArrow=block;endFill=1;endSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1010" y="700" as="sourcePoint"/><mxPoint x="1010" y="820" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t77" value="8 : slides := findRelevant(question, course)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1020" y="740" width="300" height="16" as="geometry"/></mxCell><mxCell id="e78" value="" style="html=1;rounded=0;strokeColor=#000000;endArrow=block;endFill=1;endSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1190" y="492" as="sourcePoint"/><mxPoint x="1400" y="492" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t79" value="10 : text := generate(prompt, sources)" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1130" y="472" width="320" height="16" as="geometry"/></mxCell><mxCell id="e80" value="" style="html=1;rounded=0;strokeColor=#000000;endArrow=block;endFill=1;endSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1500" y="700" as="sourcePoint"/><mxPoint x="1500" y="850" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t81" value="10.1 : request(prompt, sources)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1510" y="765" width="240" height="16" as="geometry"/></mxCell><mxCell id="e82" value="" style="html=1;rounded=0;strokeColor=#000000;endArrow=block;endFill=1;endSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="584" as="sourcePoint"/><mxPoint x="520" y="584" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t83" value="11 : «create» ans" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="520" y="566" width="260" height="16" as="geometry"/></mxCell><mxCell id="e84" value="" style="html=1;rounded=0;strokeColor=#000000;endArrow=block;endFill=1;endSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="700" as="sourcePoint"/><mxPoint x="420" y="850" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t85" value="12 : *[for each slide] «create» sourceLink" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="430" y="760" width="300" height="16" as="geometry"/></mxCell><mxCell id="b86" value="&lt;b&gt;How to read&lt;/b&gt;&lt;br&gt;Thick border: active object (has its own flow of control). Solid lines: links; names and multiplicities are not shown on links.&lt;br&gt;«local»: the link exists only while the message is sent. «self»: message to the same object. [ ]: branch condition. *[ ]: iteration.&lt;br&gt;A message name is an operation of the receiver&#x27;s class on the class diagram. Letters (5a, 6a …) mark exception branches of UC-04." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="980" width="780" height="110" as="geometry"/></mxCell><mxCell id="b87" value="&lt;b&gt;Assumptions&lt;/b&gt;&lt;br&gt;Access to the course and the AI feature (BR-01) is checked again inside ask() on the server (steps 2–3 of UC-04), even though the page already hides the field.&lt;br&gt;ask() is asynchronous: the page stays usable and shows «the answer is being prepared» (step 7, message 4) until showResult() or showMessage() arrives.&lt;br&gt;Message numbers follow the same order as the sequence diagram." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="830" y="980" width="750" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>