<mxfile host="drawio" version="32.6.10"><diagram name="Component Diagram" id="d1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t11" value="&lt;b&gt;Component diagram: AI assistant on the lecture page (UC-04)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1800" height="30" as="geometry"/></mxCell><mxCell id="t12" value="VNS — Custom University Learning Platform · Team «20/80» · Part 6, Lab 7 (Manual) · each component realizes classes of the class diagram" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1800" height="20" as="geometry"/></mxCell><mxCell id="b13" value="«executable»&lt;br&gt;&lt;b&gt;LectureUi&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;{technology = React / Next.js (web client)}&lt;/font&gt;" style="shape=component;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#000000;fontSize=12;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="420" height="150" as="geometry"/></mxCell><mxCell id="c14" value="" style="line;strokeWidth=1;fillColor=none;strokeColor=inherit;" vertex="1" parent="b13"><mxGeometry x="10" y="62" width="410" height="8" as="geometry"/></mxCell><mxCell id="c15" value="LecturePage&lt;br&gt;CourseAiSettingsPage&lt;br&gt;AiAdminPage" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="b13"><mxGeometry x="10" y="70" width="410" height="80" as="geometry"/></mxCell><mxCell id="b16" value="«executable»&lt;br&gt;&lt;b&gt;AiService&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;{technology = Node.js (NestJS) or Python (FastAPI)}&lt;/font&gt;" style="shape=component;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#000000;fontSize=12;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="390" width="420" height="170" as="geometry"/></mxCell><mxCell id="c17" value="" style="line;strokeWidth=1;fillColor=none;strokeColor=inherit;" vertex="1" parent="b16"><mxGeometry x="10" y="62" width="410" height="8" as="geometry"/></mxCell><mxCell id="c18" value="AiAssistant&lt;br&gt;AiSettingsController" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="b16"><mxGeometry x="10" y="70" width="410" height="100" as="geometry"/></mxCell><mxCell id="b19" value="«library»&lt;br&gt;&lt;b&gt;MaterialSearch&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;{technology = PostgreSQL full-text + pgvector}&lt;/font&gt;" style="shape=component;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#000000;fontSize=12;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="700" y="390" width="340" height="120" as="geometry"/></mxCell><mxCell id="c20" value="" style="line;strokeWidth=1;fillColor=none;strokeColor=inherit;" vertex="1" parent="b19"><mxGeometry x="10" y="62" width="330" height="8" as="geometry"/></mxCell><mxCell id="c21" value="MaterialIndex" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="b19"><mxGeometry x="10" y="70" width="330" height="50" as="geometry"/></mxCell><mxCell id="b22" value="«library»&lt;br&gt;&lt;b&gt;LlmClient&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;{technology = HTTPS client}&lt;/font&gt;" style="shape=component;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#000000;fontSize=12;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="680" width="420" height="110" as