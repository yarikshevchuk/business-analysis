45" value="" style="ellipse;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="261" y="611" width="18" height="18" as="geometry"/></mxCell><mxCell id="t46" value="&lt;b&gt;ILlmClient&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="284" y="611" width="150" height="18" as="geometry"/></mxCell><mxCell id="e47" value="" style="html=1;rounded=0;strokeColor=#000000;endArrow=open;endSize=10;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="560" as="sourcePoint"/><mxPoint x="270" y="611" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e48" value="" style="html=1;rounded=0;strokeColor=#000000;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="680" as="sourcePoint"/><mxPoint x="270" y="629" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b49" value="" style="ellipse;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="261" y="836" width="18" height="18" as="geometry"/></mxCell><mxCell id="t50" value="&lt;b&gt;ILlmApi&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="284" y="836" width="150" height="18" as="geometry"/></mxCell><mxCell id="e51" value="" style="html=1;rounded=0;strokeColor=#000000;endArrow=open;endSize=10;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="790" as="sourcePoint"/><mxPoint x="270" y="836" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e52" value="" style="html=1;rounded=0;strokeColor=#000000;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="900" as="sourcePoint"/><mxPoint x="270" y="854" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e53" value="" style="html=1;rounded=0;strokeColor=#000000;endArrow=open;endSize=10;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480" y="520" as="sourcePoint"/><mxPoint x="700" y="740" as="targetPoint"/><Array as="points"><mxPoint x="580" y="520"/><mxPoint x="580" y="740"/></Array></mxGeometry></mxCell><mxCell id="t54" value="«use»" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="590" y="610" width="50" height="16" as="geometry"/></mxCell><mxCell id="e55" value="" style="html=1;rounded=0;strokeColor=#000000;endArrow=open;endSize=10;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1120" y="712" as="sourcePoint"/><mxPoint x="1290" y="712" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e56" value="" style="html=1;rounded=0;strokeColor=#000000;endArrow=open;endSize=10;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1120" y="792" as="sourcePoint"/><mxPoint x="1290" y="792" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e57" value="" style="html=1;rounded=0;strokeColor=#000000;endArrow=open;endSize=10;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1120" y="872" as="sourcePoint"/><mxPoint x="1290" y="872" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e58" value="" style="html=1;rounded=0;strokeColor=#000000;endArrow=open;endSize=10;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1120" y="952" as="sourcePoint"/><mxPoint x="1290" y="952" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e59" value="" style="html=1;rounded=0;strokeColor=#000000;endArrow=open;endSize=10;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1040" y="470" as="sourcePoint"/><mxPoint x="1290" y="700" as="targetPoint"/><Array as="points"><mxPoint x="1200" y="470"/><mxPoint x="1200" y="700"/></Array></mxGeometry></mxCell><mxCell id="b60" value="&lt;b&gt;Interfaces (operations of the classes)&lt;/b&gt;&lt;br&gt;IAssistant: ask(question, lecture, student), setDailyLimit(limit), getUsageLog(from, to)&lt;br&gt;ISettings: getSettings(course), setFeature(course, feature, on), markAsGraded(assignment)&lt;br&gt;IMaterialIndex: addLecture(lecture), findRelevant(question, course)&lt;br&gt;ILlmClient: generate(prompt, sources)&lt;br&gt;ILlmApi: HTTPS request with the prompt and the course fragments (the external API of the provider)&lt;br&gt;&lt;br&gt;These are the operations that the collaboration diagram sends with the message type «call»." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1290" y="90" width="520" height="200" as="geometry"/></mxCell><mxCell id="b61" value="&lt;b&gt;How to read&lt;/b&gt;&lt;br&gt;Rectangle with two small rectangles: component; stereotype in « »: kind of the physical element (executable, library, table); {…}: technology (tagged value). The lower section lists the classes of the class diagram that the component realizes.&lt;br&gt;Circle: interface (name starts with I). Solid line from a component to a circle: the component provides the interface. Dashed arrow to a circle: the component uses it. Dashed arrow between components or to a table: dependency." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1290" y="310" width="520" height="190" as="geometry"/></mxCell><mxCell id="b62" value="&lt;b&gt;Assumptions&lt;/b&gt;&lt;br&gt;Technologies follow section 7.1 of the project idea (React / Next.js, Node.js or Python, PostgreSQL with pgvector, external LLM API). Background execution of ask() is inside AiService, so a separate queue and worker are not shown for this function.&lt;br&gt;Tables are the main tables of the AI function only; other tables of the platform are not shown." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="1010" width="820" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>