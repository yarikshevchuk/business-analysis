00;endArrow=block;endFill=1;endSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="554" y="1150" as="sourcePoint"/><mxPoint x="276" y="1150" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t108" value="13 : showResult(result)" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="265" y="1131" width="300" height="16" as="geometry"/></mxCell><mxCell id="e109" value="" style="html=1;rounded=0;strokeColor=#000000;endArrow=open;endSize=10;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="264" y="1180" as="sourcePoint"/><mxPoint x="76" y="1180" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t110" value="answer + «AI-generated» label" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="70" y="1161" width="200" height="16" as="geometry"/></mxCell><mxCell id="e111" value="" style="html=1;rounded=0;strokeColor=#000000;endArrow=block;endFill=1;endSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="566" y="1230" as="sourcePoint"/><mxPoint x="2390" y="1230" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t112" value="14 : «create» record" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1345" y="1211" width="260" height="16" as="geometry"/></mxCell><mxCell id="b113" value="&lt;u&gt;:AiUsageRecord&lt;/u&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2390" y="1210" width="160" height="40" as="geometry"/></mxCell><mxCell id="e114" value="" style="html=1;rounded=0;strokeColor=#000000;endArrow=none;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2470" y="1250" as="sourcePoint"/><mxPoint x="2470" y="1290" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t115" value="(UC-04 ends)" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;whiteSpace=wrap;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="350" y="526" width="120" height="14" as="geometry"/></mxCell><mxCell id="t116" value="(UC-04 ends)" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;whiteSpace=wrap;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="350" y="660" width="120" height="14" as="geometry"/></mxCell><mxCell id="t117" value="(UC-04 ends)" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;whiteSpace=wrap;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="350" y="810" width="120" height="14" as="geometry"/></mxCell><mxCell id="t118" value="(UC-04 ends)" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;whiteSpace=wrap;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="350" y="1004" width="120" height="14" as="geometry"/></mxCell><mxCell id="b119" value="&lt;b&gt;How to read&lt;/b&gt;&lt;br&gt;Time goes from top to bottom. Dashed vertical lines are lifelines, narrow rectangles are focuses of control. Thick header: active object.&lt;br&gt;Solid arrow with filled head: call of an operation. Open arrow: asynchronous message (ask). Dashed arrow: return. Arrow to a box: creation («create»).&lt;br&gt;Several arrows leaving the same focus with a condition in [ ] are alternative branches (5a, 6a, 8a, 10a). Each branch ends the scenario, as in UC-04." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="1330" width="900" height="90" as="geometry"/></mxCell><mxCell id="b120" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;Every message is an operation of the receiver&#x27;s class on the class diagram. AiUsageRecord on the left is the class (static operation countToday); the object created at the end (message 14) is today&#x27;s record of the student.&lt;br&gt;Messages 3 and 4 are the reason the page stays usable: ask() does not block it (step 7 of UC-04). Step 13 of UC-04 (log) is message 14." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="960" y="1330" width="900" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>