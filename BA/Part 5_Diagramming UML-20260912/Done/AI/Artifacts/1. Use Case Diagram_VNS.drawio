<mxfile host="app.diagrams.net" agent="VNS team" version="24.7.17"><diagram id="d1" name="Use Case Diagram - AI assistant on the lecture page"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sys" value="&lt;b&gt;VNS — Custom University Learning Platform&lt;/b&gt;&lt;br&gt;&lt;i&gt;function: AI assistant on the lecture page&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#222222;strokeWidth=2;verticalAlign=top;fontSize=15;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="200" y="20" width="1180" height="1360" as="geometry"/></mxCell><mxCell id="p101" value="Authorization" style="shape=folder;tabWidth=300;tabHeight=26;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fillColor=none;strokeColor=#444444;" vertex="1" parent="1"><mxGeometry x="230" y="90" width="1120" height="230" as="geometry"/></mxCell><mxCell id="p102" value="Learning with the AI assistant" style="shape=folder;tabWidth=300;tabHeight=26;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fillColor=none;strokeColor=#444444;" vertex="1" parent="1"><mxGeometry x="230" y="350" width="1120" height="680" as="geometry"/></mxCell><mxCell id="p103" value="AI settings of a course" style="shape=folder;tabWidth=300;tabHeight=26;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fillColor=none;strokeColor=#444444;" vertex="1" parent="1"><mxGeometry x="230" y="1060" width="1120" height="290" as="geometry"/></mxCell><mxCell id="user" value="Platform user" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=13;fontStyle=3;whiteSpace=wrap;strokeWidth=1.5;" vertex="1" pa