" as="geometry" /></mxCell><mxCell id="grade" value="&lt;b&gt;Grade a submitted lab&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;span style=&quot;font-size:11px&quot;&gt;extension points:&lt;br&gt;points check&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#222222;strokeWidth=3;fontSize=13;" vertex="1" parent="1"><mxGeometry x="235" y="465" width="250" height="120" as="geometry" /></mxCell><mxCell id="rejpts" value="Reject points above the maximum" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#222222;strokeWidth=1.2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="700" width="220" height="74" as="geometry" /></mxCell><mxCell id="chkfile" value="Check the report file" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#222222;strokeWidth=1.2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="610" y="190" width="220" height="66" as="geometry" /></mxCell><mxCell id="access" value="Check access to the course" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#222222;strokeWidth=1.2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="610" y="322" width="220" height="70" as="geometry" /></mxCell><mxCell id="list" value="List the submissions of the group" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#222222;strokeWidth=1.2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="610" y="450" width="220" height="70" as="geometry" /></mxCell><mxCell id="chkpts" value="Check the points" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#222222;strokeWidth=1.2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="610" y="570" width="220" height="66" as="geometry" /></mxCell><mxCell id="upd" value="Update the course progress" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#222222;strokeWidth=1.2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="610" y="690" width="220" height="70" as="geometry" /></mxCell><mxCell id="deny" valu