<mxfile host="drawio" version="32.6.10"><diagram id="Use_Case_Diagram" name="Use Case Diagram"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;Use Case Diagram: Ask the AI assistant a question about the course materials&lt;/b&gt;&lt;br&gt;VNS — Custom University Learning Platform · Team «20/80» · Part 5, Lab 1 (Manual)" style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=16;" vertex="1" parent="1"><mxGeometry x="200" y="0" width="1100" height="50" as="geometry"/></mxCell><mxCell id="c4" value="VNS — AI assistant on the lecture page" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fillColor=none;fontStyle=1;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="60" width="1110" height="1010" as="geometry"/></mxCell><mxCell id="c5" value="Student" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="300" width="40" height="80" as="geometry"/></mxCell><mxCell id="c6" value="Lecturer" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="1110" width="40" height="80" as="geometry"/></mxCell><mxCell id="c7" value="«system»&lt;br&gt;LLM API" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1420" y="420" width="40" height="80" as="geometry"/></mxCell><mxCell id="c8" value="Administrator" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1420" y="940" width="40" height="80" as="geometry"/></mxCell><mxCell id="c9" value="Get an AI summary of a lecture" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="230" y="100" width="220" height="70" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Ask the AI assistant a question&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;i&gt;extension points:&lt;/i&gt;&lt;br&gt;daily limit reached&lt;br&gt;no sources found&lt;br&gt;graded task&lt;br&gt;AI service unavailable&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="250" width="340" height="170" as="geometry"/></mxCell><mxCell id="c11" value="Check AI settings of the course" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="90" width="250" height="70" as="geometry"/></mxCell><mxCell id="c12" value="Check course access" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="200" width="250" height="70" as="geometry"/></mxCell><mxCell id="c13" value="Find relevant course materials" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="310" width="250" height="70" as="geometry"/></mxCell><mxCell id="c14" value="Generate an answer with sources" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="420" width="250" height="70" as="geometry"/></mxCell><mxCell id="c15" value="Remove personal data from the request" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="540" width="250" height="80" as="geometry"/></mxCell><mxCell id="c16" value="Reject the request: daily limit reached" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="220" y="660" width="230" height="80" as="geometry"/></mxCell><mxCell id="c17" value="Show “Not found in the course materials”" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="660" width="230" height="80" as="geometry"/></mxCell><mxCell id="c18" value="Give hints only" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="660" width="200" height="80" as="geometry"/></mxCell><mxCell id="c19" value="Show “Try again later”" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="950" y="690" width="210" height="80" as="geometry"/></mxCell><mxCell id="c20" value="Ask the group in Course Q&amp;amp;A" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="810" width="230" height="70" as="geometry"/></mxCell><mxCell id="c21" value="Choose AI features of the course" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="230" y="950" width="250" height="70" as="geometry"/></mxCell><mxCell id="c22" value="Mark a task as graded" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="510" y="950" width="210" height="70" as="geometry"/></mxCell><mxCell id="c23" value="Answer a question in Course Q&amp;amp;A" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="750" y="950" width="240" height="70" as="geometry"/></mxCell><mxCell id="c24" value="Set the daily AI request limit" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1030" y="950" width="240" height="70" as="geometry"/></mxCell><mxCell id="c25" value="" style="endArrow=none;html=1;fontFamily=Helvetica;fontSize=12;" edge="1" parent="1" source="c5" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="" style="endArrow=none;html=1;fontFamily=Helvetica;fontSize=12;" edge="1" parent="1" source="c5" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="" style="endArrow=none;html=1;fontFamily=Helvetica;fontSize=12;" edge="1" parent="1" source="c6" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="" style="endArrow=none;html=1;fontFamily=Helvetica;fontSize=12;" edge="1" parent="1" source="c6" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="" style="endArrow=none;html=1;fontFamily=Helvetica;fontSize=12;" edge="1" parent="1" source="c6" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="" style="endArrow=none;html=1;fontFamily=Helvetica;fontSize=12;" edge="1" parent="1" source="c8" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="" style="endArrow=none;html=1;fontFamily=Helvetica;fontSize=12;" edge="1" parent="1" source="c7" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="«include»" style="endArrow=open;endSize=10;dashed=1;html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="«include»" style="endArrow=open;endSize=10;dashed=1;html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c10" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="«include»" style="endArrow=open;endSize=10;dashed=1;html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c10" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="«include»" style="endArrow=open;endSize=10;dashed=1;html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c10" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value="«include»" style="endArrow=open;endSize=10;dashed=1;html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c9" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c37" value="«include»" style="endArrow=open;endSize=10;dashed=1;html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c9" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c38" value="«include»" style="endArrow=open;endSize=10;dashed=1;html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c39" value="«extend»&lt;br&gt;[daily limit reached]" style="endArrow=open;endSize=10;dashed=1;html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c16" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c40" value="«extend»&lt;br&gt;[no sources found]" style="endArrow=open;endSize=10;dashed=1;html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c17" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c41" value="«extend»&lt;br&gt;[graded task]" style="endArrow=open;endSize=10;dashed=1;html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c18" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c42" value="«extend»&lt;br&gt;[AI service unavailable]" style="endArrow=open;endSize=10;dashed=1;html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c19" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c43" value="«extend»&lt;br&gt;[Student presses “Ask the group”]" style="endArrow=open;endSize=10;dashed=1;html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c20" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c44" value="«constraint»&lt;br&gt;{AI features are off by default until the lecturer turns them on} — BR-01" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fillColor=#ffffff;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1340" y="70" width="300" height="60" as="geometry"/></mxCell><mxCell id="c45" value="" style="endArrow=none;dashed=1;html=1;dashPattern=2 3;" edge="1" parent="1" source="c44" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c46" value="«constraint»&lt;br&gt;{For a graded task the AI never gives a complete solution} — BR-02" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fillColor=#ffffff;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="930" y="800" width="290" height="60" as="geometry"/></mxCell><mxCell id="c47" value="" style="endArrow=none;dashed=1;html=1;dashPattern=2 3;" edge="1" parent="1" source="c46" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c48" value="«constraint»&lt;br&gt;{Student personal data is not sent to the external AI service} — BR-03" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fillColor=#ffffff;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1340" y="560" width="300" height="60" as="geometry"/></mxCell><mxCell id="c49" value="" style="endArrow=none;dashed=1;html=1;dashPattern=2 3;" edge="1" parent="1" source="c48" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c50" value="&lt;b&gt;Use case:&lt;/b&gt; Ask the AI assistant a question&lt;br&gt;&lt;b&gt;Primary actor:&lt;/b&gt; Student&lt;br&gt;&lt;b&gt;Secondary actors:&lt;/b&gt; LLM API (generates the answer), Lecturer (switches AI features on), Administrator (sets the daily limit)&lt;br&gt;&lt;b&gt;Preconditions:&lt;/b&gt; Student is signed in and enrolled in the course; the lecture has uploaded slides.&lt;br&gt;&lt;b&gt;Postconditions:&lt;/b&gt; the answer is saved in the student's history; one request is counted against the daily limit.&lt;br&gt;&lt;br&gt;&lt;b&gt;Main success scenario&lt;/b&gt;&lt;br&gt;1. Student opens a lecture page.&lt;br&gt;2. System checks that Student has access to the course (include: Check course access).&lt;br&gt;3. System checks that the lecturer has switched on &quot;Questions to AI&quot; for the course and shows the &quot;Ask a question about this lecture&quot; field (include: Check AI settings of the course).&lt;br&gt;4. Student types a question, e.g. &quot;Why does BFS use a queue?&quot;, and presses &quot;Go&quot;.&lt;br&gt;5. System checks that the student's daily AI request limit is not reached.&lt;br&gt;6. System finds the fragments of the course materials that match the question (include: Find relevant course materials).&lt;br&gt;7. System removes personal data from the request and sends the question with the fragments to the LLM API (include: Remove personal data from the request).&lt;br&gt;8. LLM API returns an answer based only on these fragments.&lt;br&gt;9. System shows the answer marked &quot;AI-generated&quot; with links to the lectures and slides it was taken from (include: Generate an answer with sources)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fillColor=#ffffff;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1700" y="60" width="640" height="360" as="geometry"/></mxCell><mxCell id="c51" value="&lt;b&gt;Exception scenarios&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;E1. No access or AI questions are off&lt;/b&gt; (steps 2–3)&lt;br&gt;System does not show the &quot;Ask a question about this lecture&quot; field. If Student opens it by a direct link, System shows &quot;You do not have access to this page&quot;. Nothing is sent to the AI. The use case ends.&lt;br&gt;&lt;br&gt;&lt;b&gt;E2. Daily limit reached&lt;/b&gt; (step 5) → extend: Reject the request: daily limit reached&lt;br&gt;System shows &quot;You have used all AI requests for today. Try again tomorrow.&quot; The question is not sent to the LLM API. The use case ends.&lt;br&gt;&lt;br&gt;&lt;b&gt;E3. No sources found&lt;/b&gt; (step 6) → extend: Show &quot;Not found in the course materials&quot;&lt;br&gt;The course materials contain nothing about the question. System shows &quot;Not found in the course materials&quot; and the &quot;Ask the group&quot; button. Nothing is sent to the LLM API.&lt;br&gt;E3.1. Student presses &quot;Ask the group&quot; → extend: Ask the group in Course Q&amp;amp;A. System copies the question to the &quot;Course Q&amp;amp;A&quot; of the course, where the lecturer or classmates answer it.&lt;br&gt;&lt;br&gt;&lt;b&gt;E4. Graded task&lt;/b&gt; (step 6) → extend: Give hints only&lt;br&gt;The question asks for the solution of a task that the lecturer marked as graded. System asks the LLM API for hints only and shows hints and explanations of the theory from the lectures the task is based on, without a ready-made solution (BR-02).&lt;br&gt;&lt;br&gt;&lt;b&gt;E5. AI service unavailable&lt;/b&gt; (step 8) → extend: Show &quot;Try again later&quot;&lt;br&gt;LLM API does not answer in time. System shows &quot;The AI assistant is not available now. Try again later.&quot; The request is not counted against the daily limit." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fillColor=#ffffff;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1700" y="450" width="640" height="420" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>